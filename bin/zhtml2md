#!/usr/bin/env zsh
# SPDX-License-Identifier: Apache-2.0
# bin/zhtml2md - CLI wrapper for the zhtml2md library.
#
# Locates and sources the library relative to this script, forwards
# arguments unchanged, and exits with the library's status. All
# conversion behavior lives in the library.
#
# Parse-time protection: quoted command words cannot be rewritten by
# aliases inherited from the environment; NO_ALIASES protects the rest
# of this script's parse. See zhtml2md.zsh for the full rationale.


'builtin' 'typeset' _zhtml2md_cli_loadopt="$( 'builtin' 'set' '+o' )"
'builtin' 'setopt' 'noaliases'
if [[ $'\n'$_zhtml2md_cli_loadopt$'\n' == *$'\nset +o noaliases\n'* ||
      $'\n'$_zhtml2md_cli_loadopt$'\n' == *$'\nset -o aliases\n'* ]]; then
  _zhtml2md_cli_loadopt=on
else
  _zhtml2md_cli_loadopt=off
fi

'builtin' 'source' -- "${${${(%):-%N}:A}:h}/../zhtml2md.zsh" || {
  'builtin' 'print' -r -u 2 -- 'zhtml2md: initialization: cannot load library'
  'builtin' 'exit' 1
}

if [[ $_zhtml2md_cli_loadopt == on ]]; then
  'builtin' 'setopt' 'aliases'
fi
'builtin' 'unset' _zhtml2md_cli_loadopt

'zhtml2md' "$@"
