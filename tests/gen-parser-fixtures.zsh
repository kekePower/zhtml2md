#!/usr/bin/env zsh
# Reviewed lexical/frame events, authored from the implementation plan.
# Never generate expected events by invoking the component under test.
'builtin' 'setopt' 'noaliases'
emulate -L zsh -o no_multibyte
local LC_ALL=C
local -r dir=${${${(%):-%N}:A:h}:h}/tests/parser/fixtures
command mkdir -p -- "$dir" || exit 1
local -i written=0

_zp_write() { # name mode input events stderr [strict] [status]
  emulate -L zsh -o no_multibyte
  local LC_ALL=C
  builtin printf '%s' "$3" > "$dir/$1.html"
  builtin printf '%s\n' "$2" > "$dir/$1.mode"
  builtin printf '%s' "$4" > "$dir/$1.events"
  builtin printf '%s' "$5" > "$dir/$1.stderr"
  builtin printf '%s\n' "${7:-0}" > "$dir/$1.status"
  builtin printf '%s\n' '0' > "$dir/$1.strict"
  (( ++written ))
  if [[ ${6:-yes} == yes ]]; then
    builtin printf '%s' "$3" > "$dir/$1-strict.html"
    builtin printf '%s\n' "$2" > "$dir/$1-strict.mode"
    if [[ -n $5 ]]; then
      builtin printf '%s' '' > "$dir/$1-strict.events"
      builtin printf '%s\n' '3' > "$dir/$1-strict.status"
      builtin printf '%s\n' "${5%%$'\n'*}" > "$dir/$1-strict.stderr"
    else
      builtin printf '%s' "$4" > "$dir/$1-strict.events"
      builtin printf '%s\n' '0' > "$dir/$1-strict.status"
      builtin printf '%s' '' > "$dir/$1-strict.stderr"
    fi
    builtin printf '%s\n' '1' > "$dir/$1-strict.strict"
    (( ++written ))
  fi
}

